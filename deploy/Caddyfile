# Site blocks for gryyny.si, served by the food diary's Caddy on the same VPS.
# Installed as /srv/portfolio-config/portfolio.caddy (root-owned; the deploy key cannot change it).
#
# The diary's own Caddyfile stays untouched. compose.override.yaml (next to the diary's
# compose.yaml) mounts this file, Caddyfile.all and /srv/portfolio read-only, and starts Caddy
# with Caddyfile.all, which imports both site files. The parent /srv/portfolio is mounted, not
# `current`, so later symlink swaps are visible inside the container.
#
# Applying it recreates the Caddy container (a reload cannot add mounts), which can drop
# proxied diary requests for a moment. The app and database are not restarted. The live stack
# is the Compose project "food-diary", not the directory name, so always pass -p:
#   docker compose -p food-diary run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile.all --adapter caddyfile
#   docker compose -p food-diary up -d --no-deps caddy
# Then check the diary page, its API health and its auth proxy. Later releases need no reload.

gryyny.si {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "accelerometer=(self), gyroscope=(self), camera=(), microphone=(), geolocation=()"
		# The rest of the CSP is a per-page meta tag; frame-ancestors only works as a header.
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# Next.js names the generated preview image without an extension.
	@ogImage path /opengraph-image
	header @ogImage Content-Type image/png

	# Hashed assets come from the append-only shared directory, so tabs opened on an older
	# release can still load their chunks after a newer one is promoted.
	handle /_next/static/* {
		root * /srv/portfolio/shared
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/portfolio/current
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		root * /srv/portfolio/current
		rewrite * /404.html
		file_server
	}
}

www.gryyny.si {
	redir https://gryyny.si{uri} permanent
}
