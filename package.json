{
  "name": "gryyny-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalizeExport.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "smoke": "playwright test",
    "verify:consent": "EXPORT_DIR=out-consent NEXT_PUBLIC_FIREBASE_API_KEY=fixture-api-key NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000 NEXT_PUBLIC_FIREBASE_PROJECT_ID=fixture-project NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FIXTURE000 pnpm build && playwright test -c playwright.consent.config.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
